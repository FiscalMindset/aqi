# Dhuan Detective environment template. Copy to .env and fill in.
# NEVER commit a filled .env. Names only here.

# --- runtime ---
ENV=dev
DEMO_MODE=0            # 1 = serve recorded demo data (UI shows permanent banner)
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- external data sources ---
OPENAQ_API_KEY=                 # free key from explore.openaq.org (X-API-Key)
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENMETEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com
FIRMS_MAP_KEY=                  # NASA FIRMS free MAP_KEY
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# --- AWS / services ---
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=               # set to http://localhost:4566 for LocalStack
BEDROCK_MODEL_ID=               # e.g. a Claude model id available in the region; never hardcode

# Optional Groq fluency pass over an already-grounded explanation. It never
# produces facts: the deterministic composer writes the answer and every number
# first, and Groq may only reword it. If this is unset, slow, rate-limited, or
# introduces a number that was not in the grounded text, the composed
# explanation is served unchanged. The explanation never depends on it.
GROQ_API_KEY=                   # from console.groq.com; absent is a supported state
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ENABLED=1
GROQ_TIMEOUT_SECONDS=8
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_INDEX=sources
DYNAMODB_TABLE_ESTIMATES=dhuan-estimates
DYNAMODB_TABLE_FEEDS=dhuan-feeds
DYNAMODB_TABLE_SUBSCRIPTIONS=dhuan-subscriptions
S3_BUCKET=dhuan-artifacts
SNS_TOPIC_ARN=

# Direct SMTP delivery for alert emails. Needed because SNS email requires a
# verified identity, which a new AWS account does not have yet. On AWS these
# live in SSM Parameter Store as SecureString, never in this file.
# Gmail: use an App Password (not the account password) with smtp.gmail.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
ALERT_EMAIL_FROM_NAME=Dhuan Detective
SSM_PARAMETER_PREFIX=/dhuan

# --- model ---
MODEL_VERSION=baseline-v1
H3_RESOLUTION=8
DEMO_DATA_DIR=               # where recorded demo snapshots live (fixtures/demo by default)

# --- alerts ---
SMS_ENABLED=0                   # SMS in India needs DLT sender registration; keep 0
