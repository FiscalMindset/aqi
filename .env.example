# Dhuan Detective environment template. Copy to .env and fill in.
# NEVER commit a filled .env. Names only here.

# --- runtime ---
ENV=dev
DEMO_MODE=0            # 1 = serve recorded demo data (UI shows permanent banner)
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- external data sources ---
OPENAQ_API_KEY=                 # free key from explore.openaq.org (X-API-Key)
OPENMETEO_BASE_URL=https://api.open-meteo.com
OPENMETEO_AQ_BASE_URL=https://air-quality-api.open-meteo.com
FIRMS_MAP_KEY=                  # NASA FIRMS free MAP_KEY
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# --- AWS / services ---
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=               # set to http://localhost:4566 for LocalStack
BEDROCK_MODEL_ID=               # e.g. a Claude model id available in the region; never hardcode
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_INDEX=sources
DYNAMODB_TABLE_ESTIMATES=dhuan-estimates
DYNAMODB_TABLE_FEEDS=dhuan-feeds
DYNAMODB_TABLE_SUBSCRIPTIONS=dhuan-subscriptions
S3_BUCKET=dhuan-artifacts
SNS_TOPIC_ARN=
SSM_PARAMETER_PREFIX=/dhuan

# --- model ---
MODEL_VERSION=baseline-v1
H3_RESOLUTION=8

# --- alerts ---
SMS_ENABLED=0                   # SMS in India needs DLT sender registration; keep 0
